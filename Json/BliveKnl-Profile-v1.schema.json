{
  "$id": "https://cdn.jsdelivr.net/gh/SantaQuiz/Schema/Json/BliveKnl-Profile-v1.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "BliveKnl user profile configuration and authentication data.",
  "properties": {
    "$schema": {
      "const": "https://cdn.jsdelivr.net/gh/SantaQuiz/Schema/Json/BliveKnl-Profile-v1.schema.json",
      "type": "string"
    },
    "userInfo": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "maxProperties": 0
        },
        {
          "type": "object",
          "required": [
            "uid",
            "nickname",
            "face",
            "level",
            "sign",
            "updatedAt"
          ]
        }
      ],
      "properties": {
        "face": {
          "format": "uri",
          "type": "string"
        },
        "level": {
          "description": "User level.",
          "maximum": 6,
          "minimum": 0,
          "type": "integer"
        },
        "nickname": {
          "type": "string"
        },
        "sign": {
          "description": "User personalized signature.",
          "type": "string"
        },
        "uid": {
          "pattern": "^[0-9]+$",
          "type": "string"
        },
        "updatedAt": {
          "format": "date-time",
          "type": "string"
        }
      }
    }
  },
  "required": [
    "userInfo"
  ],
  "title": "BliveKnl Profile",
  "type": "object"
}